// The knip configuration of hyper, which make lint-ts runs from the root (knip reads this file by its own discovery).
// The entries are the files that a tool starts by its path, which no import reaches:
//   - the tests, the scripts and the benchmarks, which node, vitest and make start;
//   - examples/board/client/main.ts, the browser script of the board example, which make assets bundles with
//     hyper-build-assets --app examples/board;
//   - examples/board/node/main.ts, the board Node server, which make node-server bundles with esbuild;
//   - tests/e2e/playwright.config.ts, the Playwright configuration that scripts/run-e2e.mts passes to playwright test --config;
//   - tests/scripts/fixtures/chunks/client/main.ts, the fixture app of the chunk tests of hyper-build-assets;
//   - tests/scripts/fixtures/session-worker/worker.mjs, one Node server process of tests/scripts/session-shared.test.mts.
// The binaries are the programs that the scripts start from PATH: container (Apple container, make virtiofs-check on Darwin),
// make (the dry runs of the recipe tests), openssl (the TLS certificates of session-redis-failover.test.mts) and php
// (scripts/check-parity.mts asks it whether the polyspec_template extension loads).
// The ignored dependencies are packages that no import of their workspace reaches:
//   - @polyspec/php-serialize, which the root names by the tarball URL of its release, which npm installs only from the root
//     with allow-remote=root (H21.4); packages/server/ts requires it by its version;
//   - tailwindcss of packages/build: bin/hyper-build-assets.mjs compiles the stylesheet of an app with @tailwindcss/node from
//     the CSS text '@import "tailwindcss/theme.css"', which Tailwind CSS resolves from this package.
{
  "node": {
    "entry": [
      "**/*.test.{ts,mts,cts,mjs,cjs,js}",
      "scripts/**/*.{ts,mts,cts,mjs,cjs,js}",
      "benchmarks/**/*.{ts,mts,cts,mjs,cjs,js}",
      "examples/board/client/main.ts",
      "examples/board/node/main.ts",
      "tests/e2e/playwright.config.ts",
      "tests/scripts/fixtures/chunks/client/main.ts",
      "tests/scripts/fixtures/session-worker/worker.mjs"
    ]
  },
  "ignoreBinaries": ["container", "make", "openssl", "php"],
  "ignoreDependencies": ["@polyspec/php-serialize"],
  "workspaces": {
    "packages/build": {
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
