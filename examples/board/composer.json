{
    "name": "polyspec/hyper-board-example",
    "description": "Board example for the region protocol",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/server/php", "options": { "reference": "config" } },
        { "type": "composer", "url": "https://github.com/polyspec/template/releases/download/v0.0.27/packages.json" },
        { "type": "vcs", "url": "https://github.com/min-0-max/json-schema", "no-api": true }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "min-0-max/json-schema": "^2.6.0-p2",
        "polyspec/hyper-server": "0.0.40",
        "polyspec/template": "0.0.27"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\Examples\\Board\\": "src/Board/",
            "Polyspec\\Hyper\\Examples\\Board\\Program\\": "build/server/php/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
