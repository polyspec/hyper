{
    "name": "polyspec/hyper-board-example",
    "description": "Board example for the region protocol",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/server/php", "options": { "symlink": false, "reference": "config" } },
        { "type": "artifact", "url": "../../var/products/template-php" }
    ],
    "require": {
        "php": ">=8.5",
        "ext-pdo_sqlite": "*",
        "polyspec/hyper-server": "0.0.13",
        "polyspec/template": "0.0.6"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\Examples\\Board\\": "src/Board/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    }
}
