{
    "name": "polyspec/hyper-board-example",
    "description": "Board example for the region protocol",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/server/php", "options": { "reference": "config" } },
        { "type": "composer", "url": "https://github.com/polyspec/template/releases/download/v0.0.14/packages.json" }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "polyspec/hyper-server": "0.0.21",
        "polyspec/template": "0.0.14"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\Examples\\Board\\": "src/Board/",
            "Polyspec\\Hyper\\Examples\\Board\\Program\\": "build/server/php/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
