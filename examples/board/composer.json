{
    "name": "polyspec/hyper-board-example",
    "description": "Board example for the region protocol",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/hyper-php" },
        { "type": "path", "url": "../../var/products/template/packages/template-php", "options": { "symlink": false, "reference": "config", "versions": { "polyspec/template": "dev-main" } } }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo_sqlite": "*",
        "polyspec/hyper": "@dev",
        "polyspec/template": "@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\Examples\\Board\\": "src/Board/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
