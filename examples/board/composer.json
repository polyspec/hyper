{
    "name": "polyspec/hyper-board-example",
    "description": "Board example for the region protocol",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/php", "options": { "reference": "config" } },
        { "type": "composer", "url": "https://github.com/polyspec/template/releases/download/v0.0.29/packages.json" },
        { "type": "composer", "url": "https://github.com/polyspec/json/releases/download/v0.0.34/packages.json" },
        { "type": "vcs", "url": "https://github.com/min-0-max/json-schema", "no-api": true }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "ext-polyspec_json": "*",
        "ext-polyspec_template": "*",
        "min-0-max/json-schema": "^2.6.0-p2",
        "polyspec/hyper": "0.0.40"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\Examples\\Board\\": "src/Board/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1",
            "ext-polyspec_hyper": "0.0.40",
            "ext-polyspec_json": "0.0.34",
            "ext-polyspec_template": "0.0.29"
        },
        "sort-packages": true
    }
}
