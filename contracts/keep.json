{
  "requirements": ["HY-38", "HY-41"],
  "cases": [
    { "id": "boolean", "label": "boolean", "data": { "notice": { "closed": false, "text": "t" } }, "kept": [["notice.closed", true]], "expected": { "notice": { "closed": true, "text": "t" } } },
    { "id": "different_type", "label": "different type", "data": { "notice": { "closed": false } }, "kept": [["notice.closed", "yes"]], "expected": { "notice": { "closed": false } } },
    { "id": "missing_path", "label": "missing path", "data": { "notice": { "closed": false } }, "kept": [["notice.hidden", true]], "expected": { "notice": { "closed": false } } },
    { "id": "missing_parent", "label": "missing parent", "data": { "sort": "" }, "kept": [["notice.closed", true]], "expected": { "sort": "" } },
    { "id": "string", "label": "string", "data": { "sort": "" }, "kept": [["sort", "title"]], "expected": { "sort": "title" } },
    { "id": "integer_to_fraction", "label": "integer to fraction", "data": { "zoom": 1 }, "kept": [["zoom", 2.5]], "expected": { "zoom": 2.5 } },
    { "id": "list_index", "label": "list index", "data": { "items": [{ "open": false }, { "open": false }] }, "kept": [["items.1.open", true]], "expected": { "items": [{ "open": false }, { "open": true }] } },
    { "id": "list_index_out_of_range", "label": "list index out of range", "data": { "items": [{ "open": false }] }, "kept": [["items.3.open", true]], "expected": { "items": [{ "open": false }] } },
    { "id": "index_into_a_map", "label": "index into a map", "data": { "items": { "a": 1 } }, "kept": [["items.0", 2]], "expected": { "items": { "a": 1 } } },
    { "id": "name_into_a_list", "label": "name into a list", "data": { "items": [1, 2] }, "kept": [["items.first", 3]], "expected": { "items": [1, 2] } },
    { "id": "through_a_scalar", "label": "through a scalar", "data": { "a": "text" }, "kept": [["a.b", 1]], "expected": { "a": "text" } },
    { "id": "null_to_null", "label": "null to null", "data": { "a": null }, "kept": [["a", null]], "expected": { "a": null } },
    { "id": "null_to_value", "label": "null to value", "data": { "a": null }, "kept": [["a", 1]], "expected": { "a": null } },
    { "id": "map_with_other_keys", "label": "map with other keys", "data": { "filter": { "a": 1 } }, "kept": [["filter", { "b": 2 }]], "expected": { "filter": { "a": 1 } } },
    { "id": "list", "label": "list", "data": { "tags": ["a"] }, "kept": [["tags", ["b", "c"]]], "expected": { "tags": ["b", "c"] } },
    { "id": "list_to_map", "label": "list to map", "data": { "tags": ["a"] }, "kept": [["tags", { "b": 1 }]], "expected": { "tags": ["a"] } },
    { "id": "empty_map_does_not_replace_a_map_with_keys", "label": "empty map does not replace a map with keys", "data": { "m": { "10": "a", "2": "b" } }, "kept": [["m", {}]], "expected": { "m": { "10": "a", "2": "b" } } },
    { "id": "map_replaces_an_empty_map", "label": "map replaces an empty map", "data": { "m": {} }, "kept": [["m", { "a": 1 }]], "expected": { "m": { "a": 1 } } },
    { "id": "empty_list_replaces_a_list", "label": "empty list replaces a list", "data": { "l": [1] }, "kept": [["l", []]], "expected": { "l": [] } },
    { "id": "empty_map_does_not_replace_a_list", "label": "empty map does not replace a list", "data": { "l": [1] }, "kept": [["l", {}]], "expected": { "l": [1] } },
    { "id": "empty_list_does_not_replace_a_map", "label": "empty list does not replace a map", "data": { "m": { "a": 1 } }, "kept": [["m", []]], "expected": { "m": { "a": 1 } } },
    { "id": "path_through_an_empty_map", "label": "path through an empty map", "data": { "m": {} }, "kept": [["m.a", 1]], "expected": { "m": {} } },
    { "id": "numeric_map_keys_keep_their_order", "label": "numeric map keys keep their order", "data": { "m": { "10": 1, "2": 2 } }, "kept": [["m.2", 3]], "expected": { "m": { "10": 1, "2": 3 } } },
    { "id": "in_order", "label": "in order", "data": { "a": 1, "b": "x" }, "kept": [["b", "y"], ["a", 2], ["b", "z"]], "expected": { "a": 2, "b": "z" } },
    { "id": "map_with_the_same_keys", "label": "map with the same keys", "data": { "filter": { "a": 1, "b": "x" } }, "kept": [["filter", { "a": 2, "b": "y" }]], "expected": { "filter": { "a": 2, "b": "y" } } },
    { "id": "map_with_a_nested_value_of_another_type", "label": "map with a nested value of another type", "data": { "filter": { "a": { "b": 1 } } }, "kept": [["filter", { "a": { "b": "s" } }]], "expected": { "filter": { "a": { "b": 1 } } } },
    { "id": "map_with_a_scalar_in_place_of_a_map", "label": "map with a scalar in place of a map", "data": { "filter": { "a": { "b": 1 } } }, "kept": [["filter", { "a": "s" }]], "expected": { "filter": { "a": { "b": 1 } } } },
    { "id": "list_items_conform_to_the_first_item", "label": "list items conform to the first item", "data": { "items": [{ "open": false }] }, "kept": [["items", [{ "open": true }, { "open": false }]]], "expected": { "items": [{ "open": true }, { "open": false }] } },
    { "id": "list_item_with_a_value_of_another_type", "label": "list item with a value of another type", "data": { "items": [{ "open": false }] }, "kept": [["items", [{ "open": true }, { "open": "x" }]]], "expected": { "items": [{ "open": false }] } },
    { "id": "nested_list_of_another_type", "label": "nested list of another type", "data": { "l": [[1]] }, "kept": [["l", [["a"]]]], "expected": { "l": [[1]] } },
    { "id": "any_list_replaces_an_empty_list", "label": "any list replaces an empty list", "data": { "l": [] }, "kept": [["l", [{ "x": 1 }]]], "expected": { "l": [{ "x": 1 }] } }
  ]
}
