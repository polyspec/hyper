    { "id": "the_shell_does_not_depend_on_the_parameters_or_the_query", "label": "the shell does not depend on the parameters or the query", "request": { "method": "GET", "target": "/items/7?tab=a", "headers": { "Host": "client.test", "Cookie": "hy-keep=%7B%7D" } }, "status": 200, "allHeaders": { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-cache", "Vary": "Accept, HX-Request, HX-Current-URL", "Content-Security-Policy": "frame-ancestors 'self'" }, "body": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"hyper-api\" content=\"/_props\">\n<title></title>\n</head>\n<body></body>\n</html>\n", "session": false, "actions": 0 },
