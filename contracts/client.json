    {"id": "an_unacceptable_request_under_the_data_base_path_of_a_route_without_representations_lists_only_the_json_type", "label": "an unacceptable request under the data base path of a route without representations receives the 406 of HY-116 that lists application/vnd.hyper+json alone", "request": {"method": "GET", "target": "/_props/list", "headers": {"Host": "client.test", "Accept": "application/xml"}}, "status": 406, "headers": {"Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store", "Vary": "Accept"}, "body": "application/vnd.hyper+json\n", "session": false, "actions": 0, "requirements": ["HY-65", "HY-116", "HY-117"]},
