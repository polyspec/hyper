    {"id": "a_method_other_than_get_or_post_of_a_route_with_an_action_allows_post", "label": "a DELETE of a route that declares post, of a request that the selection does not choose, is not allowed and lists POST in Allow (HY-27)", "request": {"method": "DELETE", "target": "/add", "headers": {"Host": "server.test"}}, "status": 405, "headers": {"Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store", "Allow": "GET, HEAD, POST"}, "body": "Method Not Allowed", "session": false, "actions": 0, "absentHeaders": ["Vary"], "requirements": ["HY-27", "HY-65", "HY-117"]},
    {"id": "an_unacceptable_request_that_the_selection_does_not_choose_opens_no_session", "label": "a request that the selection does not choose and that matches no type receives the 406 of HY-116 with the two page types, calls no session store method and sets no cookie (HY-120)", "request": {"method": "GET", "target": "/", "headers": {"Host": "server.test", "Accept": "application/xml"}}, "status": 406, "headers": {"Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store", "Vary": "Accept"}, "body": "text/html\napplication/vnd.hyper+json\n", "absentHeaders": ["Set-Cookie"], "session": false, "actions": 0, "storeCalls": [], "requirements": ["HY-65", "HY-116", "HY-117"]},
