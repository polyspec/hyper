        },
        "b": 1
      },
      "reads": {
        "keys": {
          "a": true
        }
      },
      "kept": {
        "a": {
          "-1": "x",
          "2": "y"
        }
      }
    },
    {
      "id": "a_large_integer_key",
      "label": "an integer literal beyond 2^53 adds the shortest text of its float (HY-73.31)",
      "templates": {
        "page.tpl": "{= a[123456789012345678]}"
      },
      "template": "page.tpl",
      "data": {
        "a": {
          "123456789012345680": "x",
          "123456789012345678": "y"
        }
      },
      "reads": {
        "keys": {
          "a": {
            "keys": {
              "123456789012345680": true
            }
          }
        }
      },
      "kept": {
        "a": {
          "123456789012345680": "x"
        }
      }
    }
  ],
  "routes": [
    {
      "id": "the_routes_of_an_application",
      "label": "the shared data reads every template of a route, each region reads its template, a route region its kept paths whole, and csrf is read whole for a route region that keeps a value on the server (HY-73.18, HY-73.19)",
      "manifest": {
        "layout": "layout.tpl",
        "title": "title.tpl",
        "regions": [
          {
            "name": "side",
            "template": "side.tpl",
            "uses": [
              "count"
            ]
          },
          {
            "name": "content",
            "page": true
          }
        ],
        "routes": [
          {
            "name": "home",
            "path": "/",
            "title": "Home",
            "template": "page.tpl"
          },
          {
            "name": "item",
            "path": "/items/{id}",
            "title": "Item",
            "template": "item.tpl"
          },
          {
            "name": "list",
            "path": "/list",
            "title": "List",
            "template": "list.tpl",
            "regions": [
              {
                "name": "rows",
                "template": "rows.tpl",
                "keep": {
                  "items.0.open": "server",
                  "items.1.open": "localStorage",
                  "flag": "cookie",
                  "tab": "sessionStorage",
                  "tags": "cookie",
                  "marks": "localStorage",
                  "filter": "server",
                  "filter.a": "localStorage"
                }
              }
            ]
          },
          {
            "name": "pick",
            "path": "/pick",
            "title": "Pick",
            "template": "pick.tpl"
          }
        ]
      },
      "templates": {
        "layout.tpl": "<title>{# title}</title>{# build}\n<aside id=\"side\">{# side}</aside>\n<main id=\"content\">{# content}</main>\n{# data}\n",
        "title.tpl": "{= title} - Site",
        "side.tpl": "<b>{= count}</b>",
        "page.tpl": "<p>{= title}|{= name}|{= shared_only}</p>",
        "item.tpl": "<i>{= id}</i>{+ part.tpl}",
        "part.tpl": "<u>{= part.label ?? \"part\"}</u>",
        "list.tpl": "<h1>{= heading}</h1>{?# rows}<ul id=\"rows\">{# rows}</ul>{/}",
        "pick.tpl": "{? view == \"a\"}{+ pick-a.tpl}{:}{# pick-b.tpl item:entry size:list}{/}",
        "pick-a.tpl": "<p>A</p>",
        "pick-b.tpl": "<p>{= item.name}{= size}{@ v = item.tags}{= v.value_}{/}</p>",
        "rows.tpl": "{@ r = items}<li{? r.open} class=\"open\"{/}>{= r.name}</li>{/}{@ t = tags}{@ x = t}{= x}{/}{/}{@ t = marks}{@ x = t}{= x}{/}{/}"
      },
      "routes": {
        "home": {
          "shared": {
            "keys": {
