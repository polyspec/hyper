    {
      "id": "the_routes_of_the_board_example",
      "label": "the read paths of every route of the board example",
      "manifest": {
        "layout": "layout.tpl",
        "title": "title.tpl",
        "regions": [
          {
            "name": "left",
            "template": "left.tpl",
            "uses": [
              "posts",
              "path"
            ]
          },
          {
            "name": "content",
            "page": true
          }
        ],
        "routes": [
          {
            "name": "home",
            "path": "/",
            "title": "홈",
            "template": "home.tpl"
          },
          {
            "name": "board.list",
            "path": "/board",
            "title": "게시판",
            "template": "board/list.tpl",
            "regions": [
              {
                "name": "notice",
                "template": "board/notice.tpl",
                "keep": {
                  "notice.closed": "server"
                }
              },
              {
                "name": "rows",
                "template": "board/rows.tpl",
                "keep": {
                  "sort": "localStorage",
                  "compact": "sessionStorage"
                }
              }
            ]
          },
          {
            "name": "board.create",
            "path": "/board/create",
            "title": "글쓰기",
            "template": "board/create.tpl",
            "post": true
          },
          {
            "name": "board.show",
            "path": "/board/{id}",
            "title": "게시글",
            "template": "board/show.tpl",
            "representations": [
              {
                "type": "application/vnd.board.post+json",
                "parameters": {
                  "version": [
                    "1"
                  ]
                },
                "methods": [
                  "GET"
                ],
                "vary": []
              }
            ],
            "regions": [
              {
                "name": "reader",
                "template": "board/reader.tpl",
                "keep": {
                  "large": "cookie"
                }
              }
            ]
          }
        ]
      },
      "templates": {
        "board/create.tpl": "<section class=\"board-form\">\n<h1>글쓰기</h1>\n<form method=\"post\" action=\"/board/create\" enctype=\"multipart/form-data\">\n<input type=\"hidden\" name=\"_csrf\" value=\"{= csrf}\">\n<label>제목 <input name=\"title\" value=\"{= values.title}\" maxlength=\"100\"></label>\n{? errors.title}<p class=\"error\">{= errors.title}</p>{/}\n<label>작성자 <input name=\"author\" value=\"{= values.author}\" maxlength=\"30\"></label>\n{? errors.author}<p class=\"error\">{= errors.author}</p>{/}\n<label>내용 <textarea name=\"body\" rows=\"12\">{= values.body}</textarea></label>\n{? errors.body}<p class=\"error\">{= errors.body}</p>{/}\n<label>첨부 <input type=\"file\" name=\"attachment\"></label>\n<div class=\"form-actions\">\n<a href=\"/board\" class=\"button secondary\">취소</a>\n<button type=\"submit\">등록</button>\n</div>\n</form>\n</section>\n",
        "board/list.tpl": "<section class=\"board\">\n<header class=\"board-head\">\n<h1>게시판</h1>\n<a href=\"/board/create\" class=\"button\">글쓰기</a>\n</header>\n{?# notice}<div id=\"notice\">{# notice}</div>{/}\n<div id=\"rows\">{# rows}</div>\n<nav class=\"pager\">\n{@ n = range(1, pages)}\n<a href=\"/board?page={= n}\"{? n == page} class=\"current\"{/}>{= n}</a>\n{/}\n</nav>\n</section>\n",
        "board/notice.tpl": "{? notice.closed}\n<p class=\"notice closed\"><button type=\"button\" class=\"link\" hy-set=\"notice.closed=false\">공지 펼치기</button></p>\n{:}\n<div class=\"notice\">\n<p>{= notice.text}</p>\n<button type=\"button\" class=\"link\" hy-set=\"notice.closed=true\">닫기</button>\n</div>\n{/}\n",
        "board/reader.tpl": "<p class=\"board-tools\"><button type=\"button\" class=\"chip{? large} current{/}\" hy-set=\"large={? large}false{:}true{/}\">큰 글자</button></p>\n<div class=\"post-body{? large} large{/}\">{= post.body | escape | nl2br | raw}</div>\n",
        "board/rows.tpl": "<div class=\"board-tools\">\n<span>정렬</span>\n<button type=\"button\" class=\"chip{? sort == ''} current{/}\" hy-set='sort=\"\"'>최신순</button>\n<button type=\"button\" class=\"chip{? sort == 'title'} current{/}\" hy-set='sort=\"title\"'>제목순</button>\n<button type=\"button\" class=\"chip{? sort == 'author'} current{/}\" hy-set='sort=\"author\"'>작성자순</button>\n<button type=\"button\" class=\"chip{? compact} current{/}\" hy-set=\"compact={? compact}false{:}true{/}\">좁게 보기</button>\n</div>\n<table class=\"board-table{? compact} compact{/}\">\n<thead>\n<tr><th>번호</th><th>제목</th><th>작성자</th><th>작성일</th></tr>\n</thead>\n<tbody>\n{:shown = posts}\n{? sort == 'title'}\n{:shown = sort(posts, 'title')}\n{:? sort == 'author'}\n{:shown = sort(posts, 'author')}\n{/}\n{@ post = shown}\n<tr id=\"post-{= post.id}\"{? post.id == highlight} class=\"new\"{/}>\n<td>{= post.id}</td>\n<td><a href=\"/board/{= post.id}\">{= post.title}</a></td>\n<td>{= post.author}</td>\n<td>{= date(post.created_at, 'Y-m-d H:i')}</td>\n</tr>\n{:}\n<tr><td colspan=\"4\" class=\"empty\">게시글이 없습니다.</td></tr>\n{/}\n</tbody>\n</table>\n",
        "board/show.tpl": "<article class=\"post\">\n<header class=\"board-head\">\n<h1>{= post.title}</h1>\n<a href=\"/board\" class=\"button secondary\">목록</a>\n</header>\n<p class=\"post-meta\">{= post.author} · {= date(post.created_at, 'Y-m-d H:i')}</p>\n{? post.attachment}<p class=\"post-file\">첨부: {= post.attachment.name} ({= post.attachment.size} bytes)</p>\n{/}<div id=\"reader\">{# reader}</div>\n</article>\n",
        "home.tpl": "<section class=\"home\">\n<h1>게시판 예제</h1>\n<p>왼쪽 메뉴에서 게시판을 여세요.</p>\n<p><a href=\"/board\" class=\"button\">게시판으로 이동</a></p>\n</section>\n",
        "layout.tpl": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{# title}</title>\n{# build}\n<link rel=\"stylesheet\" href=\"/assets/app.css\">\n{? reader}<link rel=\"stylesheet\" href=\"/assets/reader.css\">\n<script type=\"module\" src=\"/assets/reader.js\"></script>\n<script type=\"module\" src=\"/assets/after-reader.js\"></script>\n{/}<script type=\"module\" src=\"{= assets.hyper}\"></script>\n</head>\n<body hx-boost:inherited=\"true\" hx-target:inherited=\"#content\" hx-swap:inherited=\"innerMorph\">\n<div class=\"shell\">\n<aside id=\"left\">{# left}</aside>\n<main id=\"content\">{# content}</main>\n</div>\n{# data}\n</body>\n</html>\n",
        "left.tpl": "<nav class=\"left\">\n<h2>메뉴</h2>\n<ul>\n<li><a href=\"/\"{? path == '/'} class=\"active\"{/}>홈</a></li>\n<li><a href=\"/board\"{? starts_with(path, '/board')} class=\"active\"{/}>게시판 <span class=\"badge\">{= count}</span></a></li>\n</ul>\n</nav>\n",
        "title.tpl": "{= title} · {= context.site.name}"
      },
