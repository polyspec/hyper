    },
    {
      "id": "a_number_key_with_a_fraction",
      "label": "a number literal with a fraction adds its number text (HY-73.31)",
      "templates": {
        "page.tpl": "{= a[1.5]}"
      },
      "template": "page.tpl",
      "data": {
        "a": {
          "1.5": "x",
          "2": "y"
        },
        "b": 1
      },
      "reads": {
        "keys": {
          "a": {
            "keys": {
              "1.5": true
            }
          }
        }
      },
      "kept": {
        "a": {
          "1.5": "x"
        }
      }
    },
    {
      "id": "a_number_key_in_exponent_notation",
      "label": "number literals beyond the positional range add their text in exponent notation (HY-73.31)",
      "templates": {
        "page.tpl": "{= a[1e21]}|{= a[0.0000001]}"
      },
      "template": "page.tpl",
      "data": {
        "a": {
          "1e+21": "x",
          "1000000000000000000000": "y",
          "1e-7": "z",
          "0.0000001": "w"
        }
      },
      "reads": {
        "keys": {
          "a": {
            "keys": {
              "1e+21": true,
              "1e-7": true
            }
          }
        }
      },
      "kept": {
        "a": {
          "1e+21": "x",
          "1e-7": "z"
        }
      }
    },
    {
      "id": "a_negative_number_key_reads_its_object_whole",
