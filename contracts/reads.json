    {
      "id": "a_block_that_places_a_template_already_being_placed_reads_nothing",
      "label": "a block that places a template already being placed reads nothing",
      "templates": {
        "page.tpl": "{# tree.tpl node:root}",
        "tree.tpl": "{@ c = node.children}{# tree.tpl node:c}{/}{= node.name}"
      },
      "template": "page.tpl",
      "data": {
        "root": {
          "name": "r",
          "children": [],
          "y": 2
        },
        "z": 1
      },
      "reads": {
        "keys": {
          "root": {
            "keys": {
              "children": {
                "each": {}
              },
              "name": true
            }
          }
        }
      },
      "kept": {
        "root": {
          "name": "r",
          "children": []
        }
      }
    },
