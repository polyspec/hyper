{
  "cases": [
    {
      "id": "an_output_keeps_its_value_whole_and_removes_the_rest",
      "label": "an output keeps its value whole and removes the rest",
      "templates": {
        "page.tpl": "{= a.b}"
      },
      "template": "page.tpl",
      "data": {
        "a": {
          "b": "x",
          "c": 2
        },
        "d": 3
      },
      "reads": {
        "keys": {
          "a": {
            "keys": {
              "b": true
            }
          }
        }
      },
      "kept": {
        "a": {
          "b": "x"
        }
      }
    },
    {
      "id": "an_unread_root_key_is_removed",
      "label": "an unread root key is removed",
      "templates": {
        "page.tpl": "{= title}"
      },
      "template": "page.tpl",
      "data": {
        "title": "t",
        "secret": "s"
      },
      "reads": {
        "keys": {
          "title": true
        }
      },
      "kept": {
        "title": "t"
      }
    },
    {
      "id": "a_loop_keeps_every_element_with_the_members_that_it_reads",
      "label": "a loop keeps every element with the members that it reads",
      "templates": {
        "page.tpl": "{@ p = posts}{= p.title}{/}"
      },
      "template": "page.tpl",
      "data": {
        "posts": [
          {
            "title": "a",
            "id": "1"
          },
          {
            "title": "b",
            "id": "2"
          }
        ]
      },
      "reads": {
        "keys": {
          "posts": {
            "each": {
              "keys": {
                "title": true
              }
            }
          }
        }
      },
      "kept": {
        "posts": [
          {
            "title": "a"
          },
          {
            "title": "b"
          }
        ]
      }
    },
    {
      "id": "a_loop_over_a_map_keeps_every_key",
      "label": "a loop over a map keeps every key",
      "templates": {
        "page.tpl": "{@ v = m}{= v.key_}{/}"
      },
      "template": "page.tpl",
      "data": {
        "m": {
          "x": {
            "a": 1
          },
          "y": {
            "a": 2
          }
        }
      },
      "reads": {
        "keys": {
          "m": {
            "each": {}
          }
        }
      },
      "kept": {
        "m": {
          "x": {},
          "y": {}
        }
      }
    },
    {
      "id": "an_output_loop_variable_keeps_every_element_whole",
      "label": "an output loop variable keeps every element whole",
      "templates": {
        "page.tpl": "{@ t = tags}{= t}{/}"
      },
      "template": "page.tpl",
      "data": {
        "tags": [
          "a",
          "b"
        ],
        "n": 1
      },
      "reads": {
        "keys": {
          "tags": {
            "each": true
          }
        }
      },
      "kept": {
        "tags": [
          "a",
          "b"
        ]
      }
    },
    {
      "id": "value_of_a_loop_variable_reads_the_element",
      "label": "value_ of a loop variable reads the element",
      "templates": {
        "page.tpl": "{@ v = list}{= v.value_.n}{/}"
      },
      "template": "page.tpl",
      "data": {
        "list": [
          {
            "n": 1,
            "o": 2
          }
        ]
      },
      "reads": {
        "keys": {
          "list": {
            "each": {
              "keys": {
                "n": true
              }
            }
          }
        }
      },
      "kept": {
        "list": [
          {
            "n": 1
          }
        ]
      }
    },
    {
      "id": "an_assignment_reads_through_its_alias",
      "label": "an assignment reads through its alias",
      "templates": {
        "page.tpl": "{:t = messages.board}{= t[\"list.heading\"]}"
      },
      "template": "page.tpl",
      "data": {
        "messages": {
          "board": {
            "list.heading": "H",
            "list.empty": "E"
          },
          "member": {
            "x": "y"
          }
        }
      },
      "reads": {
        "keys": {
          "messages": {
            "keys": {
              "board": {
                "keys": {
                  "list.heading": true
                }
              }
            }
          },
          "t": {
            "keys": {
              "list.heading": true
            }
          }
        }
      },
      "kept": {
        "messages": {
          "board": {
            "list.heading": "H"
          }
        }
      }
    },
    {
      "id": "an_alias_assigned_after_its_use_reads_its_value",
      "label": "an alias assigned after its use reads its value",
      "templates": {
        "page.tpl": "{= x.a}{:x = obj}"
      },
      "template": "page.tpl",
      "data": {
        "obj": {
          "a": 1,
          "b": 2
        }
      },
      "reads": {
        "keys": {
          "obj": {
            "keys": {
              "a": true
            }
          },
          "x": {
            "keys": {
              "a": true
            }
          }
        }
      },
      "kept": {
        "obj": {
          "a": 1
        }
      }
    },
    {
      "id": "a_condition_reads_its_test_whole",
      "label": "a condition reads its test whole",
      "templates": {
        "page.tpl": "{? user}{= user.name}{/}"
      },
      "template": "page.tpl",
      "data": {
        "user": {
          "name": "n",
          "email": "e"
        },
        "other": 1
      },
      "reads": {
        "keys": {
          "user": true
        }
      },
      "kept": {
        "user": {
          "name": "n",
          "email": "e"
        }
      }
    },
    {
      "id": "a_function_argument_is_read_whole",
      "label": "a function argument is read whole",
      "templates": {
        "page.tpl": "{= json(cfg) | raw}"
      },
      "template": "page.tpl",
      "data": {
        "cfg": {
          "a": 1
        },
        "other": 2
      },
      "reads": {
        "keys": {
          "cfg": true
        }
      },
      "kept": {
        "cfg": {
          "a": 1
        }
      }
    },
    {
      "id": "an_operator_reads_its_operands_whole",
      "label": "an operator reads its operands whole",
      "templates": {
        "page.tpl": "{= n + m.k}"
      },
      "template": "page.tpl",
      "data": {
        "n": 1,
        "m": {
          "k": 2,
          "j": 3
        }
      },
      "reads": {
        "keys": {
          "m": {
            "keys": {
              "k": true
            }
          },
          "n": true
        }
      },
      "kept": {
        "n": 1,
        "m": {
          "k": 2
        }
      }
    },
    {
      "id": "an_index_with_a_literal_key_adds_the_key_and_a_list_keeps_its_length",
      "label": "an index with a literal key adds the key and a list keeps its length",
      "templates": {
        "page.tpl": "{= rows[1].name}"
      },
      "template": "page.tpl",
      "data": {
        "rows": [
          {
            "name": "a",
            "x": 1
          },
          {
            "name": "b",
            "x": 2
          },
          {
            "name": "c"
          }
        ]
      },
      "reads": {
        "keys": {
          "rows": {
            "keys": {
              "1": {
                "keys": {
                  "name": true
                }
              }
            }
          }
        }
      },
      "kept": {
        "rows": [
          null,
          {
            "name": "b"
          },
          null
        ]
      }
    },
    {
      "id": "an_index_with_another_key_reads_its_object_and_key_whole",
      "label": "an index with another key reads its object and key whole",
      "templates": {
        "page.tpl": "{= labels[key]}"
      },
      "template": "page.tpl",
      "data": {
        "labels": {
          "a": "A",
          "b": "B"
        },
        "key": "a",
        "z": 1
      },
      "reads": {
        "keys": {
          "key": true,
          "labels": true
        }
      },
      "kept": {
        "labels": {
          "a": "A",
          "b": "B"
        },
        "key": "a"
      }
    },
    {
      "id": "keeps_the_paths_of_both_sides",
      "label": "?? keeps the paths of both sides",
      "templates": {
        "page.tpl": "{:x = a ?? b}{= x.name}"
      },
      "template": "page.tpl",
      "data": {
        "a": {
          "name": "A",
          "k": 1
        }
      },
      "reads": {
        "keys": {
          "a": {
            "keys": {
              "name": true
            }
          },
          "b": {
            "keys": {
              "name": true
            }
          },
          "x": {
            "keys": {
              "name": true
            }
          }
        }
      },
      "kept": {
        "a": {
          "name": "A"
        }
      }
    },
    {
      "id": "a_ternary_keeps_the_paths_of_both_results_and_reads_its_test_whole",
      "label": "a ternary keeps the paths of both results and reads its test whole",
      "templates": {
        "page.tpl": "{:x = flag ? (a) : b}{= x.n}"
      },
      "template": "page.tpl",
      "data": {
        "flag": true,
        "a": {
          "n": 1,
          "m": 2
        },
        "b": {
          "n": 3,
          "m": 4
        }
      },
      "reads": {
        "keys": {
          "a": {
            "keys": {
              "n": true
            }
          },
          "b": {
            "keys": {
              "n": true
            }
          },
          "flag": true,
          "x": {
            "keys": {
              "n": true
            }
          }
        }
      },
      "kept": {
        "flag": true,
        "a": {
          "n": 1
        },
        "b": {
          "n": 3
        }
      }
    },
    {
      "id": "a_list_literal_reads_its_items_whole",
      "label": "a list literal reads its items whole",
      "templates": {
        "page.tpl": "{:l = [a, b]}{= l[1]}"
      },
      "template": "page.tpl",
      "data": {
        "a": {
          "x": 1
        },
        "b": 2,
        "c": 3
      },
      "reads": {
        "keys": {
          "a": true,
          "b": true,
          "l": {
            "keys": {
              "1": true
            }
          }
        }
      },
      "kept": {
        "a": {
          "x": 1
        },
        "b": 2
      }
    },
