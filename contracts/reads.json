    {
      "id": "a_loop_variable_that_rebinds_a_name_that_an_earlier_assignment_read_has_only_the_paths_of_its_loop_source_in_the_loop_body",
      "label": "a loop variable that rebinds a name that an earlier assignment read has only the paths of its loop source in the loop body",
      "templates": {
        "page.tpl": "{:p = page.x}{@ page = p.items}{= page.title}{/}"
      },
      "template": "page.tpl",
      "data": {
        "page": {
          "x": {
            "items": [
              {
                "title": "a",
                "body": "b"
              },
              {
                "title": "c",
                "body": "d"
              }
            ],
            "y": 1
          },
          "z": 2
        },
        "w": 3
      },
      "reads": {
        "keys": {
          "p": {
            "keys": {
              "items": {
                "each": {
                  "keys": {
                    "title": true
                  }
                }
              }
            }
          },
          "page": {
            "keys": {
              "x": {
                "keys": {
                  "items": {
                    "each": {
                      "keys": {
                        "title": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "kept": {
        "page": {
          "x": {
            "items": [
              {
                "title": "a"
              },
              {
                "title": "c"
              }
            ]
          }
        }
      }
    },
    {
      "id": "a_loop_variable_that_rebinds_the_name_of_the_source_of_an_earlier_assignment_keeps_only_the_entries_of_that_source",
      "label": "a loop variable that rebinds the name of the source of an earlier assignment keeps only the entries of that source",
      "templates": {
        "page.tpl": "{:p = q.x}{@ q = p.items}{/}"
      },
      "template": "page.tpl",
      "data": {
        "q": {
          "x": {
            "items": [
              {
                "a": 1
              },
              {
                "a": 2
              }
            ],
            "y": 1
          },
          "z": 2
        }
      },
      "reads": {
        "keys": {
          "p": {
            "keys": {
              "items": {
                "each": {}
              }
            }
          },
          "q": {
            "keys": {
              "x": {
                "keys": {
                  "items": {
                    "each": {}
                  }
                }
              }
            }
          }
        }
      },
      "kept": {
        "q": {
          "x": {
            "items": [
              {},
              {}
            ]
          }
        }
      }
    },
    {
      "id": "a_template_renders_alone_with_its_data",
