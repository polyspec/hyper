        "layout": "layout.tpl",
        "title": "title.tpl",
        "regions": [
          {
            "name": "side",
            "template": "side.tpl",
            "uses": [
              "count",
              "path"
            ]
          },
          {
            "name": "content",
            "page": true
          }
        ],
        "routes": [
          {
            "name": "home",
            "path": "/",
            "title": "Home",
            "template": "page.tpl"
          },
