    {"id": "a_201_without_location_fails", "label": "a 201 without Location fails with HY-43", "request": {"method": "PUT", "target": "/posts/8", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"title\":\"b\"}"}, "handler": {"status": 201, "body": {"id": 8}}, "handled": 1, "status": 500, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "Internal Server Error", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_201_with_location", "label": "a 201 with Location is sent without ETag", "request": {"method": "PUT", "target": "/posts/8", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"title\":\"b\"}"}, "handler": {"status": 201, "body": {"id": 8}, "headers": {"Location": "/posts/8"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "body": {"title": "b"}}, "status": 201, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Location": "/posts/8", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "{\"id\":8}", "absentHeaders": ["ETag", "Set-Cookie"]},
    {"id": "a_204_has_no_body_and_no_content_type", "label": "a DELETE answered with 204 has no body, no Content-Type and no ETag", "request": {"method": "DELETE", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1"}}, "handler": {"status": 204, "body": null}, "handled": 1, "received": {"parameters": {"version": "1"}}, "status": 204, "headers": {"Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "", "absentHeaders": ["Content-Type", "ETag", "Set-Cookie"]},
    {"id": "a_204_with_a_body_fails", "label": "a handler 204 with a body fails with HY-43", "request": {"method": "DELETE", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1"}}, "handler": {"status": 204, "body": {"id": 7}}, "handled": 1, "status": 500, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "Internal Server Error", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_location_that_starts_with_a_slash_gets_the_base_path", "label": "under the base path /api a handler Location /posts/8 is sent as /api/posts/8", "basePath": "/api", "request": {"method": "PUT", "target": "/api/posts/8", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"title\":\"b\"}"}, "handler": {"status": 201, "body": {"id": 8}, "headers": {"Location": "/posts/8"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "body": {"title": "b"}}, "status": 201, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Location": "/api/posts/8", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "{\"id\":8}", "absentHeaders": ["ETag", "Set-Cookie"]},
    {"id": "a_location_that_does_not_start_with_a_slash_keeps_its_value", "label": "under the base path /api a handler Location https://example.test/posts/8 is sent as it is", "basePath": "/api", "request": {"method": "PUT", "target": "/api/posts/8", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"title\":\"b\"}"}, "handler": {"status": 201, "body": {"id": 8}, "headers": {"Location": "https://example.test/posts/8"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "body": {"title": "b"}}, "status": 201, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Location": "https://example.test/posts/8", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "{\"id\":8}", "absentHeaders": ["ETag", "Set-Cookie"]},
    {"id": "a_method_that_the_entry_does_not_list_is_not_allowed", "label": "POST is not a method of the entry, and Allow lists its methods and HEAD", "request": {"method": "POST", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{}"}, "handled": 0, "status": 405, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Allow": "GET, HEAD, PUT, DELETE", "Vary": "Accept"}, "body": "Method Not Allowed", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_get_only_entry_allows_get_and_head", "label": "PUT on an entry with only GET receives 405 with Allow: GET, HEAD", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/json", "Content-Type": "application/json"}, "body": "{}"}, "handled": 0, "status": 405, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Allow": "GET, HEAD", "Vary": "Accept"}, "body": "Method Not Allowed", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_post_without_content_type_on_a_get_only_entry_is_not_allowed", "label": "the method check comes before 415: a POST without Content-Type on an entry with only GET receives 405", "request": {"method": "POST", "target": "/posts/7", "headers": {"Accept": "application/json"}, "body": "{}"}, "handled": 0, "status": 405, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Allow": "GET, HEAD", "Vary": "Accept"}, "body": "Method Not Allowed", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "head_has_the_headers_of_get_and_no_body", "label": "HEAD has the headers of the GET response, its ETag included, and no body", "request": {"method": "HEAD", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1"}}, "handler": {"status": 200, "body": {"id": 7, "title": "a/é"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "method": "GET"}, "status": 200, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Cache-Control": "no-cache", "Vary": "Accept", "ETag": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\"", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "", "absentHeaders": ["Set-Cookie"]},
    {"id": "a_put_with_text_plain_is_unsupported", "label": "a PUT with Content-Type text/plain receives 415", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "text/plain"}, "body": "{\"title\":\"b\"}"}, "handled": 0, "status": 415, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Vary": "Accept"}, "body": "Unsupported Media Type", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_put_without_content_type_is_unsupported", "label": "a PUT without Content-Type has no media type application/json and receives 415", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1"}, "body": "{\"title\":\"b\"}"}, "handled": 0, "status": 415, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Vary": "Accept"}, "body": "Unsupported Media Type", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_put_with_json_and_a_charset_is_accepted", "label": "Content-Type application/json; charset=utf-8 is accepted, and a 200 to PUT has no ETag", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "Application/JSON; charset=utf-8"}, "body": "{\"title\":\"b\"}"}, "handler": {"status": 200, "body": {"id": 7, "title": "b"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "body": {"title": "b"}}, "status": 200, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "{\"id\":7,\"title\":\"b\"}", "absentHeaders": ["ETag", "Set-Cookie"]},
    {"id": "a_body_that_is_not_json_is_a_bad_request", "label": "a body that is not JSON text receives 400", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"title\":"}, "handled": 0, "status": 400, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Vary": "Accept"}, "body": "Bad Request", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "a_body_outside_the_data_model_is_a_bad_request", "label": "a number outside the data model receives 400", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"n\":9007199254740993}"}, "handled": 0, "status": 400, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'", "Vary": "Accept"}, "body": "Bad Request", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "if_none_match_with_the_tag_receives_304", "label": "a GET whose If-None-Match equals the tag receives 304 with the headers of the 200 except Content-Type", "request": {"method": "GET", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "If-None-Match": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\""}}, "handler": {"status": 200, "body": {"id": 7, "title": "a/é"}}, "handled": 1, "received": {"parameters": {"version": "1"}}, "status": 304, "headers": {"ETag": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\"", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "", "absentHeaders": ["Content-Type", "Set-Cookie"], "session": false},
    {"id": "head_with_if_none_match_with_the_tag_receives_304", "label": "a HEAD whose If-None-Match equals the tag receives 304 with the headers of the 200 except Content-Type", "request": {"method": "HEAD", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "If-None-Match": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\""}}, "handler": {"status": 200, "body": {"id": 7, "title": "a/é"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "method": "GET"}, "status": 304, "headers": {"ETag": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\"", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "", "absentHeaders": ["Content-Type", "Set-Cookie"], "session": false},
    {"id": "if_none_match_with_another_tag_receives_200", "label": "a GET whose If-None-Match names another tag receives 200", "request": {"method": "GET", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "If-None-Match": "\"9d25dbf24c9f03e47a74c54b7547bd89\""}}, "handler": {"status": 200, "body": {"id": 7, "title": "a/é"}}, "handled": 1, "received": {"parameters": {"version": "1"}}, "status": 200, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Cache-Control": "no-cache", "Vary": "Accept", "ETag": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\"", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "{\"id\":7,\"title\":\"a/é\"}", "absentHeaders": ["Set-Cookie"]},
    {"id": "a_representation_request_opens_no_session_and_passes_no_cookie", "label": "the handler receives no Cookie header, and the response sets no cookie and opens no session", "request": {"method": "GET", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Cookie": "hy-session=0123456789abcdef0123456789abcdef; a=1"}}, "handler": {"status": 200, "body": {"id": 7, "title": "a/é"}}, "handled": 1, "received": {"parameters": {"version": "1"}, "absentHeaders": ["Cookie"]}, "status": 200, "headers": {"Content-Type": "application/vnd.example.post+json; version=1", "Cache-Control": "no-cache", "Vary": "Accept", "ETag": "\"0b3414c7e65b5faa2d4ab3f8af4e09a9\"", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "{\"id\":7,\"title\":\"a/é\"}", "absentHeaders": ["Set-Cookie"], "session": false},
    {"id": "no_rows_is_not_found", "label": "an ORM error NO_ROWS is answered with 404", "request": {"method": "GET", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1"}}, "handler": {"throw": {"class": "OrmError", "code": "NO_ROWS"}}, "handled": 1, "status": 404, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "Not Found", "absentHeaders": ["ETag", "Set-Cookie"], "session": false},
    {"id": "revision_changed_is_precondition_failed", "label": "an ORM error REVISION_CHANGED is answered with 412", "request": {"method": "PUT", "target": "/posts/7", "headers": {"Accept": "application/vnd.example.post+json;version=1", "Content-Type": "application/json"}, "body": "{\"title\":\"b\"}"}, "handler": {"throw": {"class": "OrmError", "code": "REVISION_CHANGED"}}, "handled": 1, "status": 412, "headers": {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'"}, "body": "Precondition Failed", "absentHeaders": ["ETag", "Set-Cookie"], "session": false}
