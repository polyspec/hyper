{
  "schema": 1,
  "comment": "The language parity of hyper: the implementations of the server (PHP, Python, Node), the browser package, the profiles that group them, and the units that every implementation of a profile holds. The server implementations run the shared vectors of contracts/ and the public functions they have in common; the browser package is the one browser implementation (HY-98).",
  "implementations": [
    {
      "name": "php",
      "runner": "php",
      "prose": [
        "PHP",
        "PHP server"
      ],
      "roots": [
        "packages/server/php"
      ],
      "symbols": {
        "extractor": "php",
        "entry": "packages/server/php/src"
      }
    },
    {
      "name": "python",
      "runner": "python",
      "prose": [
        "Python",
        "Python server"
      ],
      "roots": [
        "packages/server/python"
      ],
      "command": "packages/server/python/.venv/bin/python",
      "symbols": {
        "extractor": "python",
        "entry": "packages/server/python/src/polyspec/hyper"
      }
    },
    {
      "name": "ts",
      "runner": "vitest",
      "prose": [
        "TypeScript",
        "Node",
        "Node server"
      ],
      "roots": [
        "packages/server/ts"
      ],
      "symbols": {
        "extractor": "ts",
        "entry": "packages/server/ts/dist/index.d.ts"
      }
    },
    {
      "name": "client",
      "runner": "vitest",
      "prose": [
        "browser package",
        "browser code"
      ],
      "roots": [
        "packages/client"
      ],
      "symbols": {
        "extractor": "ts",
        "entry": "packages/client/dist/index.d.ts"
      }
    }
  ],
  "profiles": [
    {
      "name": "server",
      "implementations": [
        "php",
        "python",
        "ts"
      ],
      "reason": "The browser package is the one browser implementation of the protocol (HY-98), so the server implementations hold the server units, which the browser package does not hold.",
      "spec": [
        "docs/spec/protocol.md#browser"
      ]
    },
    {
      "name": "browser",
      "implementations": [
        "client"
      ],
      "reason": "Only the browser package runs in the browser; PHP, Python and Node serve the protocol and hold no browser code (HY-98).",
      "spec": [
        "docs/spec/protocol.md#browser"
      ]
    },
    {
      "name": "file-sessions",
      "implementations": [
        "python",
        "ts"
      ],
      "reason": "PHP keeps its sessions in its own session handler, while the Node and Python servers keep each session in a file of one directory (HY-54, HY-104).",
      "spec": [
        "docs/spec/protocol.md#node-server"
      ]
    }
  ],
  "suites": [
    "contracts/*.json"
  ],
  "comparators": [],
  "tools": [
    {
      "root": "tests/scripts",
      "reason": "the node tests of the repository tools of scripts/ (the verifier, the build, the publish and the check scripts), which implement no contract"
    },
    {
      "root": "tests/e2e",
      "reason": "the browser tests of the example board, which run the example application and implement no contract"
    },
    {
      "root": "tests/package-install",
      "reason": "the install test of the published packages, which consumes them and implements no contract"
    },
    {
      "root": "tests/virtiofs",
      "reason": "the output-file test of the virtiofs check of the repository tools, which implements no contract"
    }
  ],
  "testPatterns": [
