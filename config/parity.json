{
  "schema": 1,
  "comment": "The language parity of hyper: the implementations of the server (PHP, Python, Node), and the units that every one of them holds. The server implementations run the shared vectors of contracts/ and the public functions they have in common. The browser package is a separate component, not an implementation of the server spec (HR-98); its tests belong to the package itself and are outside this declaration.",
  "implementations": [
    {
      "name": "php",
      "runner": "php",
      "prose": [
        "PHP",
        "PHP server"
      ],
      "roots": [
        "packages/server/php"
      ],
      "symbols": {
        "extractor": "php",
        "entry": "packages/server/php/src"
      }
    },
    {
      "name": "python",
      "runner": "python",
      "prose": [
        "Python",
        "Python server"
      ],
      "roots": [
        "packages/server/python"
      ],
      "command": "packages/server/python/.venv/bin/python",
      "symbols": {
        "extractor": "python",
        "entry": "packages/server/python/src/polyspec/hyper"
      }
    },
    {
      "name": "ts",
      "runner": "vitest",
      "prose": [
        "TypeScript",
        "Node",
        "Node server"
      ],
      "roots": [
        "packages/server/ts"
      ],
      "symbols": {
        "extractor": "ts",
        "entry": "packages/server/ts/dist/index.d.ts"
      }
    }
  ],
  "suites": [
    "contracts/*.json"
  ],
  "comparators": [],
  "tools": [
    {
      "root": "tests/scripts",
      "reason": "the node tests of the repository tools of scripts/ (the verifier, the build, the publish and the check scripts), which implement no contract"
    },
    {
      "root": "tests/e2e",
      "reason": "the browser tests of the example board, which run the example application and implement no contract"
    },
    {
      "root": "tests/package-install",
      "reason": "the install test of the published packages, which consumes them and implements no contract"
    },
    {
      "root": "tests/virtiofs",
      "reason": "the output-file test of the virtiofs check of the repository tools, which implements no contract"
    },
    {
      "root": "packages/client/tests",
      "reason": "the tests of the browser package, which is a separate component and not an implementation of the server spec (HR-98); they belong to the package itself"
    },
    {
      "root": "tests/python_package",
      "reason": "the package-data test of the Python distribution polyspec-hyper-server, which checks its pyproject.toml and its py.typed marker and implements no contract of the protocol"
    }
  ],
  "testPatterns": [
    {
      "runner": "python",
      "globs": [
        "packages/server/python/tests/render/render_*.py"
