{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/hyper",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": [
    "CHANGELOG.ko.md"
  ],
  "packages": [
    {
      "kind": "npm",
      "directory": "packages/client",
      "name": "@polyspec/hyper-client",
      "product": "hyper-client",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/server/ts",
      "name": "@polyspec/hyper-server",
      "product": "hyper-server",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/build",
      "name": "@polyspec/hyper-build",
      "product": "hyper-build",
      "runtime": "ts"
    },
    {
      "kind": "composer",
      "directory": "packages/server/php",
      "name": "polyspec/hyper-server",
      "product": "hyper-server",
      "runtime": "php"
    },
    {
      "kind": "wheel",
      "directory": "packages/server/python",
      "name": "polyspec-hyper-server",
      "product": "hyper-server",
      "runtime": "python"
    }
  ],
  "manifests": {
    "package.json": "version",
    "packages/client/package.json": "archive",
    "packages/server/ts/package.json": "archive",
    "packages/build/package.json": "archive",
    "packages/server/php/composer.json": "archive",
    "packages/server/python/pyproject.toml": "archive"
  },
  "notReleased": {
    "tests/package-install/package.json": "the test package that installs the npm archives of the packages",
    "examples/board/composer.json": "the example application, which installs the packages from the checkout",
    "composer.json": "the private development root of packages/server/php, which resolves the packages from the checkout"
  },
  "goModules": {}
}
