{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/hyper",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": [
    "CHANGELOG.ko.md"
  ],
  "packages": [
    {
      "kind": "npm",
      "directory": "packages/client",
      "name": "@polyspec/hyper-client",
      "product": "hyper-client",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/ts",
      "name": "@polyspec/hyper",
      "product": "hyper",
      "runtime": "ts"
    },
    {
      "kind": "npm",
      "directory": "packages/cli",
      "name": "@polyspec/hyper-cli",
      "product": "hyper-cli",
      "runtime": "ts"
    },
    {
      "kind": "composer",
      "directory": "packages/php",
      "name": "polyspec/hyper",
      "product": "hyper",
      "runtime": "php"
    },
    {
      "kind": "wheel",
      "directory": "packages/python",
      "name": "polyspec-hyper",
      "product": "hyper",
      "runtime": "python"
    }
  ],
  "manifests": {
    "package.json": "version",
    "packages/client/package.json": "archive",
    "packages/ts/package.json": "archive",
    "packages/cli/package.json": "archive",
    "packages/php/composer.json": "archive",
    "packages/python/pyproject.toml": "archive"
  },
  "notReleased": {
    "tests/package-install/package.json": "the test package that installs the npm archives of the packages",
    "examples/board/composer.json": "the example application, which installs the packages from the checkout",
    "composer.json": "the private development root of packages/php, which resolves the packages from the checkout"
  },
  "goModules": {},
  "annotatedTags": true,
  "packageFiles": [
    "package.json",
    "composer.json",
    "Cargo.toml",
    "pyproject.toml",
    "go.mod",
    "VERSION"
  ],
  "writtenFiles": [
    "config/phpunit/composer.json",
    ".mise/locks/**"
  ]
}
