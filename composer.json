{
    "name": "polyspec/hyper-workspace",
    "description": "The development install of the PHP package packages/server/php with the PHP package polyspec/template of the template release; not published",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/server/php",
            "options": {
                "reference": "config"
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/template",
                "version": "0.0.13",
                "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
                "type": "library",
                "license": "MIT",
                "require": {
                    "php": ">=8.4",
                    "ext-mbstring": "*",
                    "opis/json-schema": "^2.6"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\Template\\": "src/"
                    }
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/template/releases/download/v0.0.13/polyspec-template-php-0.0.13.zip",
                    "shasum": "0b803ca719042a61c543c22c572b44d66ce5d639"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "polyspec/hyper-server": "0.0.21",
        "polyspec/template": "0.0.13"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^13.4.2"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "packages/server/php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "packages/server/php/tests/",
            "Polyspec\\Hyper\\Tests\\Program\\": "packages/server/php/tests/build/server/php/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
