{
    "name": "polyspec/hyper-workspace",
    "description": "The development install of the PHP package packages/hyper-server-php with the PHP package polyspec/template of the template release; not published",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "var/products/hyper-server-php",
            "options": {
                "symlink": false,
                "reference": "config"
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/template",
                "version": "0.0.5",
                "type": "library",
                "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
                "license": "MIT",
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/template/releases/download/v0.0.5/polyspec-template-php-0.0.5.zip",
                    "shasum": "0e0f1b690ab394175a7999ef071c2c0780dcfa93"
                },
                "require": {
                    "php": "^8.2",
                    "ext-mbstring": "*"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\Template\\": "src/"
                    }
                },
                "bin": [
                    "bin/template.php"
                ]
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "polyspec/hyper-server": "0.0.8",
        "polyspec/template": "0.0.5"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "packages/hyper-server-php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "packages/hyper-server-php/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
