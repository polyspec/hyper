{
    "name": "polyspec/hyper-workspace",
    "description": "The development install of the PHP package packages/hyper-php with the PHP package polyspec/template of the template release; not published",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "var/products/hyper-php",
            "options": {
                "symlink": false,
                "reference": "config"
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/template",
                "version": "0.0.4",
                "type": "library",
                "description": "Template language implementation: lexer, parser, renderer, functions and CLI",
                "license": "MIT",
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/template/releases/download/v0.0.4/polyspec-template-0.0.4.zip",
                    "shasum": "99874991fa028f34d5905ae0ecc66f104f166a48"
                },
                "require": {
                    "php": "^8.2",
                    "ext-mbstring": "*"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\Template\\": "src/"
                    }
                },
                "bin": [
                    "bin/template.php"
                ]
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "polyspec/hyper": "0.0.4",
        "polyspec/template": "0.0.4"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "packages/hyper-php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "packages/hyper-php/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
