{
    "name": "polyspec/hyper-workspace",
    "description": "The development install of the PHP package packages/hyper-server-php with the PHP package polyspec/template of the template release; not published",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/hyper-server-php",
            "options": {
                "symlink": false,
                "reference": "config"
            }
        },
        {
            "type": "artifact",
            "url": "var/products/template-php"
        }
    ],
    "require": {
        "php": ">=8.5",
        "polyspec/hyper-server": "0.0.13",
        "polyspec/template": "0.0.6"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^13.4.2"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "packages/hyper-server-php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "packages/hyper-server-php/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    }
}
