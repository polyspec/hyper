{
    "name": "polyspec/hyper-workspace",
    "description": "The development install of the PHP package packages/php with the PHP package polyspec/template from the Composer repository of the template release; not published",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/php",
            "options": {
                "reference": "config"
            }
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/template/releases/download/v0.0.27/packages.json"
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/json/releases/download/v0.0.34/packages.json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-polyspec_json": "*",
        "min-0-max/json-schema": "^2.6.0-p2",
        "polyspec/hyper": "0.0.40",
        "polyspec/template": "0.0.27"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^13.4.2"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": [
                "packages/php/src/App/",
                "packages/php/src/Data/",
                "packages/php/src/Form/",
                "packages/php/src/Host/",
                "packages/php/src/Http/",
                "packages/php/src/Page/",
                "packages/php/src/Representation/",
                "packages/php/src/Result/",
                "packages/php/src/Session/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "packages/php/tests/"
        },
        "files": [
            "packages/php/tests/Support/CoreStandIn/functions.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.1",
            "ext-polyspec_hyper": "0.0.40",
            "ext-polyspec_json": "0.0.34"
        },
        "sort-packages": true
    }
}
