{
    "name": "polyspec/hyper-workspace",
    "description": "The development install of the PHP package packages/server/php with the PHP package polyspec/template from the Composer repository of the template release; not published",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/server/php",
            "options": {
                "reference": "config"
            }
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/template/releases/download/v0.0.22/packages.json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "require": {
        "php": ">=8.4",
        "min-0-max/json-schema": "2.6.0-p2",
        "polyspec/hyper-server": "0.0.33",
        "polyspec/template": "0.0.22"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^13.4.2"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "packages/server/php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "packages/server/php/tests/",
            "Polyspec\\Hyper\\Tests\\Program\\": "packages/server/php/tests/build/server/php/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
