  "cases": [
    { "label": "an HTML request of a page receives the shell", "request": { "method": "GET", "target": "/", "headers": { "Host": "client.test" } }, "status": 200, "headers": { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'" }, "shell": true, "session": false, "actions": 0 },
    { "label": "the shell does not depend on the parameters or the query", "request": { "method": "GET", "target": "/items/7?tab=a", "headers": { "Host": "client.test", "Cookie": "hy-keep=%7B%7D" } }, "status": 200, "headers": { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-cache", "Vary": "Accept", "Content-Security-Policy": "frame-ancestors 'self'" }, "shell": true, "session": false, "actions": 0 },
