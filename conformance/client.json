    { "label": "a page path outside the data base path takes only GET", "request": { "method": "POST", "target": "/add", "headers": { "Host": "client.test" }, "form": { "name": "x" } }, "status": 405, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Method Not Allowed", "session": false, "actions": 0 },
    { "label": "a document request outside the data base path is not acceptable", "request": { "method": "GET", "target": "/", "headers": { "Host": "client.test", "Accept": "application/json" } }, "status": 406, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Not Acceptable", "session": false, "actions": 0 },
    { "label": "a region request outside the data base path is not acceptable", "request": { "method": "GET", "target": "/items/7", "headers": { "Host": "client.test", "Accept": "application/json", "HX-Request": "true" } }, "status": 406, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Not Acceptable", "session": false, "actions": 0 },
    { "label": "the keep path outside the data base path is a page path without a route", "request": { "method": "POST", "target": "/_hyper/keep", "headers": { "Host": "client.test" }, "csrf": true, "form": { "region": "rows", "path": "open", "value": "true" } }, "status": 404, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Not Found", "actions": 0 },
