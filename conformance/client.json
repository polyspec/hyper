    { "label": "a path that starts with the text of the data base path is not under it", "request": { "method": "GET", "target": "/_propsx", "headers": { "Host": "client.test" } }, "status": 404, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Not Found", "session": false, "actions": 0 },
    { "label": "the keep path under the data base path stores a kept value", "request": { "method": "POST", "target": "/_props/_hyper/keep", "headers": { "Host": "client.test" }, "csrf": true, "form": { "region": "rows", "path": "open", "value": "true" } }, "status": 204, "headers": { "Content-Security-Policy": "frame-ancestors 'self'" }, "body": "", "actions": 0 },
