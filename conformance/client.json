    { "label": "a request that the selection does not choose receives JSON without the data base path", "request": { "method": "GET", "target": "/items/7", "headers": { "Host": "server.test", "Accept": "application/json" } }, "status": 200, "headers": { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "Content-Security-Policy": "frame-ancestors 'self'" }, "json": { "route": "item", "params": { "id": "7" }, "regions": ["side", "content"] }, "actions": 0 },
    { "label": "the data base path is not a base path of a request that the selection does not choose", "request": { "method": "GET", "target": "/_props/items/7", "headers": { "Host": "server.test", "Accept": "application/json" } }, "status": 404, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Not Found", "session": false, "actions": 0 },
