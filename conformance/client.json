    { "label": "an action under the data base path checks the CSRF token", "request": { "method": "POST", "target": "/_props/add", "headers": { "Host": "client.test", "Accept": "application/json", "HX-Request": "true" }, "form": { "name": "x" } }, "status": 403, "headers": { "Content-Type": "text/plain; charset=utf-8", "Content-Security-Policy": "frame-ancestors 'self'", "Cache-Control": "no-store" }, "body": "Forbidden", "actions": 0 },
