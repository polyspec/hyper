{
  "cases": [
    { "label": "an output keeps its value whole and removes the rest", "templates": {"page.tpl": "{= a.b}"}, "template": "page.tpl", "data": {"a": {"b": "x", "c": 2}, "d": 3}, "reads": {"keys": {"a": {"keys": {"b": true}}}}, "kept": {"a": {"b": "x"}} },
    { "label": "an unread root key is removed", "templates": {"page.tpl": "{= title}"}, "template": "page.tpl", "data": {"title": "t", "secret": "s"}, "reads": {"keys": {"title": true}}, "kept": {"title": "t"} },
    { "label": "a loop keeps every element with the members that it reads", "templates": {"page.tpl": "{@ p = posts}{= p.title}{/}"}, "template": "page.tpl", "data": {"posts": [{"title": "a", "id": "1"}, {"title": "b", "id": "2"}]}, "reads": {"keys": {"posts": {"each": {"keys": {"title": true}}}}}, "kept": {"posts": [{"title": "a"}, {"title": "b"}]} },
    { "label": "a loop over a map keeps every key", "templates": {"page.tpl": "{@ v = m}{= v.key_}{/}"}, "template": "page.tpl", "data": {"m": {"x": {"a": 1}, "y": {"a": 2}}}, "reads": {"keys": {"m": {"each": {}}}}, "kept": {"m": {"x": {}, "y": {}}} },
    { "label": "an output loop variable keeps every element whole", "templates": {"page.tpl": "{@ t = tags}{= t}{/}"}, "template": "page.tpl", "data": {"tags": ["a", "b"], "n": 1}, "reads": {"keys": {"tags": {"each": true}}}, "kept": {"tags": ["a", "b"]} },
    { "label": "value_ of a loop variable reads the element", "templates": {"page.tpl": "{@ v = list}{= v.value_.n}{/}"}, "template": "page.tpl", "data": {"list": [{"n": 1, "o": 2}]}, "reads": {"keys": {"list": {"each": {"keys": {"n": true}}}}}, "kept": {"list": [{"n": 1}]} },
    { "label": "an assignment reads through its alias", "templates": {"page.tpl": "{:t = messages.board}{= t[\"list.heading\"]}"}, "template": "page.tpl", "data": {"messages": {"board": {"list.heading": "H", "list.empty": "E"}, "member": {"x": "y"}}}, "reads": {"keys": {"messages": {"keys": {"board": {"keys": {"list.heading": true}}}}, "t": {"keys": {"list.heading": true}}}}, "kept": {"messages": {"board": {"list.heading": "H"}}} },
    { "label": "an alias assigned after its use reads its value", "templates": {"page.tpl": "{= x.a}{:x = obj}"}, "template": "page.tpl", "data": {"obj": {"a": 1, "b": 2}}, "reads": {"keys": {"x": {"keys": {"a": true}}, "obj": {"keys": {"a": true}}}}, "kept": {"obj": {"a": 1}} },
    { "label": "a condition reads its test whole", "templates": {"page.tpl": "{? user}{= user.name}{/}"}, "template": "page.tpl", "data": {"user": {"name": "n", "email": "e"}, "other": 1}, "reads": {"keys": {"user": true}}, "kept": {"user": {"name": "n", "email": "e"}} },
    { "label": "a function argument is read whole", "templates": {"page.tpl": "{= json(cfg) | raw}"}, "template": "page.tpl", "data": {"cfg": {"a": 1}, "other": 2}, "reads": {"keys": {"cfg": true}}, "kept": {"cfg": {"a": 1}} },
    { "label": "an operator reads its operands whole", "templates": {"page.tpl": "{= n + m.k}"}, "template": "page.tpl", "data": {"n": 1, "m": {"k": 2, "j": 3}}, "reads": {"keys": {"n": true, "m": {"keys": {"k": true}}}}, "kept": {"n": 1, "m": {"k": 2}} },
    { "label": "an index with a literal key adds the key and a list keeps its length", "templates": {"page.tpl": "{= rows[1].name}"}, "template": "page.tpl", "data": {"rows": [{"name": "a", "x": 1}, {"name": "b", "x": 2}, {"name": "c"}]}, "reads": {"keys": {"rows": {"keys": {"1": {"keys": {"name": true}}}}}}, "kept": {"rows": [null, {"name": "b"}, null]} },
    { "label": "an index with another key reads its object and key whole", "templates": {"page.tpl": "{= labels[key]}"}, "template": "page.tpl", "data": {"labels": {"a": "A", "b": "B"}, "key": "a", "z": 1}, "reads": {"keys": {"labels": true, "key": true}}, "kept": {"labels": {"a": "A", "b": "B"}, "key": "a"} },
    { "label": "?? keeps the paths of both sides", "templates": {"page.tpl": "{:x = a ?? b}{= x.name}"}, "template": "page.tpl", "data": {"a": {"name": "A", "k": 1}}, "reads": {"keys": {"x": {"keys": {"name": true}}, "a": {"keys": {"name": true}}, "b": {"keys": {"name": true}}}}, "kept": {"a": {"name": "A"}} },
    { "label": "a ternary keeps the paths of both results and reads its test whole", "templates": {"page.tpl": "{:x = flag ? (a) : b}{= x.n}"}, "template": "page.tpl", "data": {"flag": true, "a": {"n": 1, "m": 2}, "b": {"n": 3, "m": 4}}, "reads": {"keys": {"x": {"keys": {"n": true}}, "flag": true, "a": {"keys": {"n": true}}, "b": {"keys": {"n": true}}}}, "kept": {"flag": true, "a": {"n": 1}, "b": {"n": 3}} },
    { "label": "a list literal reads its items whole", "templates": {"page.tpl": "{:l = [a, b]}{= l.1}"}, "template": "page.tpl", "data": {"a": {"x": 1}, "b": 2, "c": 3}, "reads": {"keys": {"l": {"keys": {"1": true}}, "a": true, "b": true}}, "kept": {"a": {"x": 1}, "b": 2} },
    { "label": "an include reads in the scope of the including template", "templates": {"page.tpl": "{:c = card}{+ part.tpl}", "part.tpl": "{= c.title}"}, "template": "page.tpl", "data": {"card": {"title": "T", "body": "B"}}, "reads": {"keys": {"c": {"keys": {"title": true}}, "card": {"keys": {"title": true}}}}, "kept": {"card": {"title": "T"}} },
    { "label": "a block reads its template with its scope arguments", "templates": {"page.tpl": "{# box.tpl item:post}", "box.tpl": "{= item.title}{= site}"}, "template": "page.tpl", "data": {"post": {"title": "T", "id": 1}, "site": "S", "other": 1}, "reads": {"keys": {"post": {"keys": {"title": true}}, "site": true}}, "kept": {"post": {"title": "T"}, "site": "S"} },
    { "label": "a block that places a template already being placed reads nothing", "templates": {"page.tpl": "{# tree.tpl node:root}", "tree.tpl": "{@ c = node.children}{# tree.tpl node:c}{/}{= node.name}"}, "template": "page.tpl", "data": {"root": {"name": "r", "children": [], "y": 2}, "z": 1}, "reads": {"keys": {"root": {"keys": {"children": {"each": {}}, "name": true}}}}, "kept": {"root": {"name": "r", "children": []}} },
    { "label": "a map that loses every key stays a map", "templates": {"page.tpl": "{= m.a}"}, "template": "page.tpl", "data": {"m": {"b": 1}}, "reads": {"keys": {"m": {"keys": {"a": true}}}}, "kept": {"m": {}} },
    { "label": "a scalar under a path that continues stays as it is", "templates": {"page.tpl": "{= s.x}"}, "template": "page.tpl", "data": {"s": "text"}, "reads": {"keys": {"s": {"keys": {"x": true}}}}, "kept": {"s": "text"} }
  ]
}
