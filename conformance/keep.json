{
  "cases": [
    { "label": "boolean", "data": { "notice": { "closed": false, "text": "t" } }, "kept": [["notice.closed", true]], "expected": { "notice": { "closed": true, "text": "t" } } },
    { "label": "different type", "data": { "notice": { "closed": false } }, "kept": [["notice.closed", "yes"]], "expected": { "notice": { "closed": false } } },
    { "label": "missing path", "data": { "notice": { "closed": false } }, "kept": [["notice.hidden", true]], "expected": { "notice": { "closed": false } } },
    { "label": "missing parent", "data": { "sort": "" }, "kept": [["notice.closed", true]], "expected": { "sort": "" } },
    { "label": "string", "data": { "sort": "" }, "kept": [["sort", "title"]], "expected": { "sort": "title" } },
    { "label": "integer to fraction", "data": { "zoom": 1 }, "kept": [["zoom", 2.5]], "expected": { "zoom": 2.5 } },
    { "label": "list index", "data": { "items": [{ "open": false }, { "open": false }] }, "kept": [["items.1.open", true]], "expected": { "items": [{ "open": false }, { "open": true }] } },
    { "label": "list index out of range", "data": { "items": [{ "open": false }] }, "kept": [["items.3.open", true]], "expected": { "items": [{ "open": false }] } },
    { "label": "index into a map", "data": { "items": { "a": 1 } }, "kept": [["items.0", 2]], "expected": { "items": { "a": 1 } } },
    { "label": "name into a list", "data": { "items": [1, 2] }, "kept": [["items.first", 3]], "expected": { "items": [1, 2] } },
    { "label": "through a scalar", "data": { "a": "text" }, "kept": [["a.b", 1]], "expected": { "a": "text" } },
    { "label": "null to null", "data": { "a": null }, "kept": [["a", null]], "expected": { "a": null } },
    { "label": "null to value", "data": { "a": null }, "kept": [["a", 1]], "expected": { "a": null } },
    { "label": "map", "data": { "filter": { "a": 1 } }, "kept": [["filter", { "b": 2 }]], "expected": { "filter": { "b": 2 } } },
    { "label": "list", "data": { "tags": ["a"] }, "kept": [["tags", ["b", "c"]]], "expected": { "tags": ["b", "c"] } },
    { "label": "list to map", "data": { "tags": ["a"] }, "kept": [["tags", { "b": 1 }]], "expected": { "tags": ["a"] } },
    { "label": "in order", "data": { "a": 1, "b": "x" }, "kept": [["b", "y"], ["a", 2], ["b", "z"]], "expected": { "a": 2, "b": "z" } }
  ]
}
