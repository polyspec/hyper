<?xml version="1.0"?>
<!--
  The phpcs rules of hyper. make lint-php runs phpcs from the root, where phpcs reads this file, on the PHP files of the
  checkout. PSR-12 includes PSR-1, whose MultipleClasses sniff enforces one class per
  file (S2): composer dump-autoload strict-psr does not, since it accepts a file whose first class matches its name and
  drops the others in silence.
-->
<ruleset name="polyspec">
    <description>PSR-12 for the PHP of a polyspec repository (S2)</description>
    <arg name="extensions" value="php"/>
    <rule ref="PSR12"/>
    <!-- No swallowed error (K256): an empty statement, an empty catch included. -->
    <rule ref="Generic.CodeAnalysis.EmptyStatement"/>
    <!-- No silenced error (K334): the @ operator hides a warning; a call that needs it says why with phpcs:ignore and its reason. -->
    <rule ref="Generic.PHP.NoSilencedErrors"/>
    <!-- The stubs of a PHP extension are the input of php-src's gen_stub.php, which declares every class of the extension in one file by its design. -->
    <exclude-pattern>*.stub.php</exclude-pattern>
    <!-- The classes and the test of the PHP reader fixture are input data whose layout is the case that recipe-check.test.mts
         reads (H35.105), such as a static method on one line, so they keep that layout. The autoload.php of the fixture
         runs in the reader and stays linted. -->
    <exclude-pattern>tests/scripts/fixtures/recipe/readers/php/src/*</exclude-pattern>
    <exclude-pattern>tests/scripts/fixtures/recipe/readers/php/tests/*</exclude-pattern>
</ruleset>
