{
    "name": "polyspec/hyper-server",
    "version": "0.0.10",
    "description": "Server side of the region protocol: routes, actions and region JSON for template language layouts",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "polyspec/template": "0.0.5"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
