                  "kind": "map",
                  "value": [
                    [
                      "shared",
                      {
                        "kind": "bool",
                        "value": true
                      }
                    ],
                    [
                      "regions",
                      {
                        "kind": "map",
                        "value": []
                      }
                    ]
                  ]
                }
              ]
            ]
          },
          "options": {
            "build": "1111111111111111111111111111111111111111111111111111111111111111",
            "timezone": "+09:00",
            "context": false,
            "base_path": "",
            "data_base_path": null,
            "form_types": [
              "application/x-www-form-urlencoded"
            ]
