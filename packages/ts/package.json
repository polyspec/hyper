{
  "name": "@polyspec/hyper",
  "version": "0.0.40",
  "description": "The server library of the region protocol for Node.js; the browser package is @polyspec/hyper-client. Routes, loaders, actions, sessions, documents and JSON",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./native/generated/index.d.ts",
      "default": "./native/generated/index.mjs"
    }
  },
  "files": [
    "dist",
    "native/generated/*.node",
    "native/generated/index.cjs",
    "native/generated/index.mjs",
    "native/generated/index.d.ts",
    "native/wasm/generated/*.mjs",
    "native/wasm/generated/*.js",
    "native/wasm/generated/*.d.ts",
    "native/wasm/generated/*.wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@polyspec/hyper-client": "0.0.40",
    "@polyspec/php-serialize": "0.0.6",
    "@polyspec/template": "0.0.27"
  },
  "napi": {
    "binaryName": "hyper",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  }
}
