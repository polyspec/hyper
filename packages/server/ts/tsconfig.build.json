{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "stripInternal": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
