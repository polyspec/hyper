{
    "name": "polyspec/hyper-server",
    "version": "0.0.18",
    "description": "Server side of the region protocol: routes, actions and region JSON for template language layouts",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/template": "0.0.11"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^13.4.2"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Hyper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Hyper\\Tests\\": "tests/",
            "Polyspec\\Hyper\\Tests\\Program\\": "tests/build/server/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
