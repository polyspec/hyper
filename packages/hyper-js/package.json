{
  "name": "@polyspec/hyper",
  "version": "0.0.1",
  "description": "Browser extension for htmx that renders region JSON with template language templates",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates-index": {
      "types": "./templates-index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates-index.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@polyspec/template": "file:../../var/products/template/packages/template-ts",
    "htmx.org": "4.0.0"
  }
}
