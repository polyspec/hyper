  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@polyspec/hyper-client": "0.0.40",
    "@polyspec/template": "0.0.27",
    "@polyspec/template-compiler": "0.0.27",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
