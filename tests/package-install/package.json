{
  "name": "@polyspec/hyper-package-install",
  "version": "0.0.8",
  "private": true,
  "description": "A package that installs the hyper npm packages from their directories and runs them under node (HR-61)",
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@polyspec/hyper-client": "file:../../packages/client",
    "@polyspec/hyper-server": "file:../../packages/server/ts",
    "@polyspec/php-serialize": "https://github.com/polyspec/php-serialize/releases/download/v0.0.3/polyspec-php-serialize-0.0.3.tgz",
    "@polyspec/template": "https://github.com/polyspec/template/releases/download/v0.0.22/polyspec-template-0.0.22.tgz"
  },
  "overrides": {
    "@polyspec/php-serialize": "$@polyspec/php-serialize",
    "@polyspec/template": "$@polyspec/template"
  }
}
