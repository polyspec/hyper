// Tests scripts/binding-commit.mts (G-6, CK-20): it gives the commit of the polyspec-binding-core that polyspec-hyper
// depends on in Cargo.lock, also when the lock holds a second polyspec-binding-core that another library requires, and
// fails when polyspec-hyper names none or the lock has no Git commit for it.
import assert from 'node:assert/strict';
import { test } from 'node:test';
import { bindingCommit } from '../../scripts/binding-commit.mts';

const TAG = '4c3653bef093f696efb6c0c679887548f0f57103';
const BRANCH = '369fcec3e14d7e013cf217cb9c33c554b291e042';

const binding = (version: string, source: string) => `[[package]]
name = "polyspec-binding-core"
version = "${version}"
source = "${source}"
dependencies = [
 "serde",
]
`;
const hyper = (dependency: string) => `[[package]]
name = "polyspec-hyper"
version = "0.0.40"
dependencies = [
 "${dependency}",
 "polyspec-template",
]
`;
const lock = (...stanzas: string[]) => `# This file is automatically @generated by Cargo.\nversion = 4\n\n${stanzas.join('\n')}`;

test('gives the commit of the one polyspec-binding-core of the lock', () => {
  const text = lock(binding('0.0.13', `git+https://github.com/polyspec/binding.git?tag=v0.0.13#${TAG}`), hyper('polyspec-binding-core'));
  assert.equal(bindingCommit(text), TAG);
});

test('gives the commit of the version that polyspec-hyper names when the lock holds two', () => {
  const text = lock(
    binding('0.0.1', `git+https://github.com/polyspec/binding.git?branch=v1%2Frust-core#${BRANCH}`),
    binding('0.0.13', `git+https://github.com/polyspec/binding.git?tag=v0.0.13#${TAG}`),
    hyper('polyspec-binding-core 0.0.13'),
  );
  assert.equal(bindingCommit(text), TAG);
});

test('fails when polyspec-hyper names no polyspec-binding-core', () => {
  const text = lock(binding('0.0.13', `git+https://github.com/polyspec/binding.git?tag=v0.0.13#${TAG}`), hyper('serde'));
  assert.throws(() => bindingCommit(text), /polyspec-hyper names no polyspec-binding-core in Cargo.lock/);
});

test('fails when the named polyspec-binding-core has no Git commit', () => {
  const text = lock(binding('0.0.13', 'registry+https://github.com/rust-lang/crates.io-index'), hyper('polyspec-binding-core'));
  assert.throws(() => bindingCommit(text), /polyspec-binding-core 0.0.13 has no pinned commit/);
});
