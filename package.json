{
  "name": "@polyspec/hyper-workspace",
  "version": "0.0.21",
  "private": true,
  "description": "Region protocol that renders template language regions in the browser with htmx",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "workspaces": [
    "packages/client",
    "packages/build",
    "packages/server/ts"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.70/polyspec-kit-npm-0.0.70.tgz",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "htmx.org": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@polyspec/template": "https://github.com/polyspec/template/releases/download/v0.0.12/polyspec-template-npm-0.0.12.tgz",
    "@polyspec/template-compiler": "https://github.com/polyspec/template/releases/download/v0.0.12/polyspec-template-compiler-npm-0.0.12.tgz"
  },
  "overrides": {
    "@polyspec/template": "$@polyspec/template",
    "@polyspec/template-compiler": "$@polyspec/template-compiler"
  }
}
