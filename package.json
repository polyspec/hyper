{
  "name": "@polyspec/hyper-workspace",
  "version": "0.0.39",
  "private": true,
  "description": "Region protocol that renders template language regions in the browser with htmx",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/client",
    "packages/build",
    "packages/server/ts"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.105/polyspec-kit-0.0.105.tgz",
    "@types/node": "26.6.5",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "htmx.org": "4.0.0",
    "redis": "6.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@polyspec/php-serialize": "https://github.com/polyspec/php-serialize/releases/download/v0.0.6/polyspec-php-serialize-0.0.6.tgz",
    "@polyspec/template": "https://github.com/polyspec/template/releases/download/v0.0.27/polyspec-template-0.0.27.tgz",
    "@polyspec/template-compiler": "https://github.com/polyspec/template/releases/download/v0.0.27/polyspec-template-compiler-0.0.27.tgz"
  },
  "overrides": {
    "@polyspec/php-serialize": "$@polyspec/php-serialize",
    "@polyspec/template": "$@polyspec/template",
    "@polyspec/template-compiler": "$@polyspec/template-compiler"
  }
}
