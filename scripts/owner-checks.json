{
  "comment": "The owner checks of the repository paths (HY-88), read by scripts/owner-check.mjs: make owner-check runs the targets and node test files of the rules whose globs match a changed path. Every tracked path matches a rule. A rule with variable passes the matched paths to its targets in that make variable. Globs: * within one path segment, ** across segments, {a,b} either alternative.",
  "always": [],
  "owners": [
    { "paths": ["docs/**", "*.md", "packages/*/README*.md"], "targets": ["docs-check"] },
    { "paths": ["packages/hyper-php/{src,tests}/**", "packages/hyper-php/{composer.json,composer.lock,phpstan.neon,phpunit.xml,pint.json}"], "targets": ["test-php", "analyse-php", "lint"] },
    { "paths": ["packages/hyper-js/**"], "targets": ["test-js", "package-check", "bundle-size"] },
    { "paths": ["packages/hyper-node/**"], "targets": ["test-node", "package-check"] },
    { "paths": ["conformance/**"], "targets": ["test-js", "test-node", "test-php"] },
    { "paths": ["examples/board/{app,templates}/**"], "targets": ["templates-check", "parity", "server-parity", "e2e", "bundle-size"] },
    { "paths": ["examples/board/{client,public}/**", "examples/board/compare.html"], "targets": ["parity", "e2e", "bundle-size"] },
    { "paths": ["examples/board/src/**", "examples/board/{composer.json,composer.lock,pint.json}", "examples/board/var/**"], "targets": ["lint", "parity", "server-parity", "e2e"] },
    { "paths": ["examples/board/node/**"], "targets": ["server-parity"] },
    { "paths": ["examples/board/tests/parity/**"], "targets": ["parity", "server-parity"] },
    { "paths": ["tests/e2e/**", "playwright.config.ts"], "targets": ["e2e"], "tests": ["tests/scripts/run-e2e.test.mjs"] },
    { "paths": ["tests/virtiofs/**"], "targets": ["virtiofs-check"] },
    { "paths": ["tests/package-install/**"], "targets": ["package-check"] },
    { "paths": ["tests/scripts/*.test.mjs"], "tests": ["$path"] },
    { "paths": ["tests/scripts/fixtures/{chunks,invalid-manifest}/**"], "tests": ["tests/scripts/build-assets.test.mjs"] },
    { "paths": ["tests/scripts/fixtures/regions/**"], "tests": ["tests/scripts/check-templates.test.mjs"] },
    { "paths": ["tests/scripts/declared-template.mjs"], "tests": ["tests/scripts/build-assets.test.mjs", "tests/scripts/check-templates.test.mjs", "tests/scripts/package-source.test.mjs", "tests/scripts/template-dir.test.mjs"] },
    { "paths": ["tests/scripts/make-dry-run.mjs"], "tests": ["tests/scripts/full-run.test.mjs", "tests/scripts/check-recipes.test.mjs", "tests/scripts/toolchain.test.mjs", "tests/scripts/template-copy.test.mjs"] },
    { "paths": ["tests/scripts/requires.mjs"], "tests": ["tests/scripts/run-tests.test.mjs", "tests/scripts/check-recipes.test.mjs", "tests/scripts/template-dir.test.mjs"] },
    { "paths": ["scripts/bench-browser.mjs"], "targets": ["bench-browser"] },
    { "paths": ["scripts/bench-server.php"], "targets": ["bench-server-smoke"] },
    { "paths": ["scripts/board-servers.mjs", "scripts/serve-edge.mjs"], "targets": ["parity"], "tests": ["tests/scripts/board-servers.test.mjs", "tests/scripts/check-parity.test.mjs", "tests/scripts/run-e2e.test.mjs", "tests/scripts/serve-demo.test.mjs"] },
    { "paths": ["scripts/build-assets.mjs", "scripts/template-files.mjs", "scripts/build-templates.mjs"], "targets": ["bundle-size"], "tests": ["tests/scripts/build-assets.test.mjs", "tests/scripts/template-dir.test.mjs", "tests/scripts/package-source.test.mjs"] },
    { "paths": ["scripts/build-server.mjs", "scripts/template-rules.mjs", "scripts/check-templates.mjs"], "targets": ["templates-check"], "tests": ["tests/scripts/check-templates.test.mjs", "tests/scripts/package-source.test.mjs"] },
    { "paths": ["scripts/output-files.mjs"], "tests": ["tests/scripts/publish.test.mjs", "tests/scripts/output-files.test.mjs", "tests/scripts/build-assets.test.mjs"] },
    { "paths": ["scripts/check-bundle-size.mjs", "config/bundle-size.json"], "targets": ["bundle-size"], "tests": ["tests/scripts/check-bundle-size.test.mjs"] },
    { "paths": ["scripts/check-documents.mjs"], "targets": ["docs-check"], "tests": ["tests/scripts/check-documents.test.mjs"] },
    { "paths": ["scripts/check-parity.mjs"], "targets": ["parity"], "tests": ["tests/scripts/check-parity.test.mjs"] },
    { "paths": ["scripts/copy-package.mjs", "scripts/publish.mjs", "scripts/tracked-files.mjs"], "targets": ["template-check"], "tests": ["tests/scripts/publish.test.mjs", "tests/scripts/template-copy.test.mjs", "tests/scripts/build-assets.test.mjs"] },
    { "paths": ["scripts/copy-template.mjs"], "targets": ["template-check"], "tests": ["tests/scripts/template-copy.test.mjs"] },
    { "paths": ["scripts/full-run.mjs"], "tests": ["tests/scripts/full-run.test.mjs", "tests/scripts/push-gate.test.mjs"] },
    { "paths": ["scripts/git-hooks.mjs", "scripts/push-gate.mjs", ".githooks/**", ".github/workflows/*.yml"], "tests": ["tests/scripts/push-gate.test.mjs", "tests/scripts/ci-workflow.test.mjs", "tests/scripts/github-ruleset.test.mjs"] },
    { "paths": ["scripts/github-ruleset.mjs", ".github/ruleset.json"], "tests": ["tests/scripts/github-ruleset.test.mjs"] },
    { "paths": ["scripts/holder-lock.mjs"], "tests": ["tests/scripts/publish.test.mjs", "tests/scripts/serve-demo.test.mjs", "tests/scripts/full-run.test.mjs"] },
    { "paths": ["scripts/owner-check.mjs", "scripts/owner-checks.json"], "tests": ["tests/scripts/owner-check.test.mjs"] },
    { "paths": ["scripts/run-e2e.mjs"], "targets": ["e2e"], "tests": ["tests/scripts/run-e2e.test.mjs"] },
    { "paths": ["scripts/run-tests.mjs", "scripts/test-progress/**"], "tests": ["tests/scripts/run-tests.test.mjs"] },
    { "paths": ["scripts/line-end.mjs"], "tests": ["tests/scripts/check-recipes.test.mjs"] },
    { "paths": ["scripts/ci-run.mjs"], "tests": ["tests/scripts/ci-run.test.mjs"] },
    { "paths": ["scripts/serve-demo.mjs"], "tests": ["tests/scripts/serve-demo.test.mjs"] },
    { "paths": ["scripts/toolchain.mjs", "config/toolchain.json", ".node-version"], "tests": ["tests/scripts/toolchain.test.mjs", "tests/scripts/package-build.test.mjs"] },
    { "paths": ["scripts/tsc.mjs"], "targets": ["test-js"], "tests": ["tests/scripts/package-build.test.mjs"] },
    { "paths": ["package.json", "package-lock.json", ".npmrc"], "targets": ["test-js", "test-node", "package-check"], "tests": ["tests/scripts/toolchain.test.mjs", "tests/scripts/no-symlinks.test.mjs", "tests/scripts/template-copy.test.mjs"] },
    { "paths": ["Makefile"], "tests": ["tests/scripts/toolchain.test.mjs", "tests/scripts/template-copy.test.mjs", "tests/scripts/full-run.test.mjs", "tests/scripts/check-recipes.test.mjs", "tests/scripts/push-gate.test.mjs", "tests/scripts/owner-check.test.mjs", "tests/scripts/ci-workflow.test.mjs", "tests/scripts/github-ruleset.test.mjs"] },
    { "paths": [".gitignore"], "tests": ["tests/scripts/ignored-files.test.mjs"] }
  ]
}
